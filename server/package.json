{
  "name": "@streamline/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "format:check": "prettier --check src",
    "test": "vitest run src",
    "test:coverage": "vitest run --coverage",
    "eval": "tsx evals/run-all.ts",
    "eval:live": "EVAL_LIVE=1 tsx evals/run-all.ts",
    "eval:ablation": "tsx evals/retrieval-ablation.eval.ts",
    "eval:ablation:live": "EVAL_LIVE=1 tsx evals/retrieval-ablation.eval.ts",
    "start:worker": "node dist/worker.js",
    "dev:worker": "tsx watch src/worker.ts",
    "db:generate": "tsx ./node_modules/drizzle-kit/bin.cjs generate",
    "db:push": "tsx ./node_modules/drizzle-kit/bin.cjs push",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:down": "tsx src/db/rollback.ts",
    "db:seed:clean": "tsx scripts/cleanup-seeds.ts",
    "db:studio": "tsx ./node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@google/genai": "^2.20.0",
    "@neondatabase/serverless": "^0.10.4",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.34.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "googleapis": "^176.0.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
